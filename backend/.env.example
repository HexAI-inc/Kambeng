# Backend example environment variables (do NOT commit secrets)
ENVIRONMENT=dev
PROJECT_NAME=Kambeng - GambiaGive API
FRONTEND_URL=http://localhost:4200
BACKEND_PUBLIC_URL=http://127.0.0.1:8001
MEDIA_ROOT=uploads
MEDIA_URL_PREFIX=/uploads
MAX_CAMPAIGN_IMAGES=5
MAX_CAMPAIGN_IMAGE_SIZE_MB=5
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kambeng
SECRET_KEY=replace-with-a-long-random-secret

# DigitalOcean Spaces (S3-compatible) configuration
# If you created a Space named 'hexaistorage' in region 'lon1', set:
STORAGE_STRATEGY=do_spaces
DO_SPACES_KEY=your_spaces_key_here
DO_SPACES_SECRET=your_spaces_secret_here
DO_SPACES_REGION=lon1
# API endpoint for boto3 writes/reads.
DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
# Public origin endpoint used to build returned URLs.
DO_SPACES_PUBLIC_ENDPOINT=https://hexaistorage.lon1.digitaloceanspaces.com
# The bucket / space name you created.
DO_SPACES_BUCKET=hexaistorage
# All uploads are stored under this folder inside the bucket.
DO_SPACES_PREFIX=kambeng

# Stripe (card payments)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Notes:
# - Make the Space public (or configure appropriate ACLs) if you want objects
#   to be directly retrievable via the returned URLs.