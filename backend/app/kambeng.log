{"level": 20, "time": 1775517139523, "pid": 1023823, "hostname": "c-jallohs-shit", "msg": "SELECT count(*) AS count_1 \nFROM (SELECT $1::VARCHAR AS model, CAST(campaigns.id AS VARCHAR) AS entity_id, campaigns.title AS title, campaigns.slug AS subtitle, CAST(campaigns.status AS VARCHAR) AS status, campaigns.created_at AS created_at \nFROM campaigns UNION ALL SELECT $2::VARCHAR AS model, CAST(users.id AS VARCHAR) AS entity_id, users.full_name AS title, users.email AS subtitle, CAST(users.role AS VARCHAR) AS status, users.created_at AS created_at \nFROM users UNION ALL SELECT $3::VARCHAR AS model, CAST(donations.id AS VARCHAR) AS entity_id, donations.client_reference AS title, donations.donor_name AS subtitle, CAST(donations.status AS VARCHAR) AS status, donations.created_at AS created_at \nFROM donations UNION ALL SELECT $4::VARCHAR AS model, CAST(reviews.id AS VARCHAR) AS entity_id, reviews.donor_name AS title, reviews.comment AS subtitle, $5 AS status, reviews.created_at AS created_at \nFROM reviews UNION ALL SELECT $6::VARCHAR AS model, CAST(payouts.id AS VARCHAR) AS entity_id, payouts.client_reference AS title, CAST(payouts.net_amount AS VARCHAR) AS subtitle, CAST(payouts.status AS VARCHAR) AS status, payouts.created_at AS created_at \nFROM payouts UNION ALL SELECT $7::VARCHAR AS model, CAST(kyc_submissions.id AS VARCHAR) AS entity_id, CAST(kyc_submissions.document_type AS VARCHAR) AS title, CAST(kyc_submissions.user_id AS VARCHAR) AS subtitle, CAST(kyc_submissions.status AS VARCHAR) AS status, kyc_submissions.created_at AS created_at \nFROM kyc_submissions UNION ALL SELECT $8::VARCHAR AS model, CAST(moderation_reports.id AS VARCHAR) AS entity_id, CAST(moderation_reports.reason AS VARCHAR) AS title, moderation_reports.description AS subtitle, CAST(moderation_reports.status AS VARCHAR) AS status, moderation_reports.created_at AS created_at \nFROM moderation_reports) AS search_results", "taskName": "starlette.middleware.base.BaseHTTPMiddleware.__call__.<locals>.call